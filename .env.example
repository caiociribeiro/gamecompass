# Configuração local de desenvolvimento. Copie para .env.
NEO4J_USER=neo4j
NEO4J_PASSWORD=compass_secret
NEO4J_DATABASE=neo4j

# Endereço para scripts executados diretamente no seu computador.
# O Compose define bolt://neo4j:7687 para os serviços api e data.
NEO4J_URI=bolt://localhost:7687

API_PORT=8000
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# Opcional: substitui o destino que o Vite calcula a partir de API_PORT.
# API_PROXY_TARGET=http://127.0.0.1:8000
